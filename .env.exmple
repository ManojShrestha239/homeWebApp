# ---- Database (used by Postgres container and by Laravel) ----
DB_DATABASE=app_db              # Name of the database to create
DB_USERNAME=app_user            # Database login name
DB_PASSWORD=change_me_strong    # Database password (change this!)

# ---- pgAdmin login (web UI for the database) ----
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me_too

# ---- Cloudflare Tunnel token (only needed with --profile tunnel) ----
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Local user ID for file ownership on Linux (run: id -u / id -g) ----
UID=1000
GID=1000